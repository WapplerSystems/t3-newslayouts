plugin.tx_news.settings {
    demandClass = WapplerSystems\Newslayouts\Domain\Model\Dto\Demand

}

plugin.tx_news.view.layoutRootPaths.9 = EXT:newslayouts/Resources/Private/Layouts/
plugin.tx_news.view.partialRootPaths.9 = EXT:newslayouts/Resources/Private/Partials/
plugin.tx_news.view.templateRootPaths.9 = EXT:newslayouts/Resources/Private/Templates/


plugin.tx_news.settings {

  imageClass = {$plugin.tx_news.settings.imageClass}

  list {
    headingType = {$plugin.tx_news.settings.list.headingType}
  }

  detail {
    top {
      maxWidth = {$plugin.tx_news.settings.detail.top.maxWidth}
      maxHeight = {$plugin.tx_news.settings.detail.top.maxHeight}
    }

    gallery {
      maxWidth = {$plugin.tx_news.settings.detail.gallery.maxWidth}
      maxHeight = {$plugin.tx_news.settings.detail.gallery.maxHeight}
    }

    headingType = {$plugin.tx_news.settings.detail.headingType}
  }

  # Defaults for the "Slider" template layout (overridable per plugin via FlexForm)
  slider {
    breakpoints576 = 1
    breakpoints768 = 2
    breakpoints992 = 3
    # 0 = page-wise (advance a full view per step); >= 1 = fixed number of slides per step
    slidesPerGroup = 0
    spaceBetween = 20
    loop = 0
    navigation = 1
    pagination = 1
    autoplay = 0
    delay = 5000
    newsTitleType = 4
    display = 3
    disableCss = 0
  }

}

tt_content.news_pi1.dataProcessing {
  400 = WapplerSystems\Newslayouts\Frontend\DataProcessing\DummyImageProcessor
  400 {
    references.table = tt_content
    references.fieldName = tx_newslayouts_dummyimage
  }
}
