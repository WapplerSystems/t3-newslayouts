
# Layout for news article
TCEFORM.tx_news_domain_model_news.layout.addItems {
  topImageGalleryBottom = LLL:EXT:newslayouts/Resources/Private/Language/tsconfig.xlf:layout.topImageGalleryBottom
  topImageGalleryBottom.icon = EXT:newslayouts/Resources/Public/Icons/layout1.svg
}

TCEFORM.tx_news_domain_model_news.fal_media.config.overrideChildTca.columns.crop.config.cropVariants {
  1-1 < cropVariants.1-1
  16-9 < cropVariants.16-9
}

tx_news.imageFormats {
  1-1 = LLL:EXT:core/Resources/Private/Language/locallang_wizards.xlf:imwizard.ratio.1_1
  16-9 = LLL:EXT:core/Resources/Private/Language/locallang_wizards.xlf:imwizard.ratio.16_9
}
