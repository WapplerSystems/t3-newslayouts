{
    "name": "wapplersystems/newslayouts",
    "type": "typo3-cms-extension",
    "description": "Extends EXT:news plugins and records with individual layout settings. Supports bootstrap css framework",
    "homepage": "https://github.com/WapplerSystems/t3-newslayouts",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3",
        "extension",
        "news",
        "layout",
        "bootstrap"
    ],
    "authors": [
        {
            "name": "Sven Wappler",
            "email": "typo3@wappler.systems",
            "role": "Developer",
            "homepage": "https://wappler.systems"
        }
    ],
    "support": {
        "issues": "https://github.com/WapplerSystems/t3-newslayouts/issues",
        "source": "https://github.com/WapplerSystems/t3-newslayouts"
    },
    "require": {
        "typo3/cms-core": "^13",
        "georgringer/news": ">9"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\Newslayouts\\": "Classes"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "newslayouts"
        }
    }
}