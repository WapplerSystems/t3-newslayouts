




# image formats

cropVariants {
  free {
    title = LLL:EXT:core/Resources/Private/Language/locallang_wizards.xlf:imwizard.ratio.free
    allowedAspectRatios {
      NaN {
        title = LLL:EXT:core/Resources/Private/Language/locallang_wizards.xlf:imwizard.ratio.free
        value = 0.0
      }
    }
  }

  1-1 {
    title = LLL:EXT:core/Resources/Private/Language/locallang_wizards.xlf:imwizard.ratio.1_1
    allowedAspectRatios {
      1:1 {
        title = LLL:EXT:core/Resources/Private/Language/locallang_wizards.xlf:imwizard.ratio.1_1
        value = 1.0
      }
    }
  }

  16-9 {
    title = LLL:EXT:core/Resources/Private/Language/locallang_wizards.xlf:imwizard.ratio.16_9
    allowedAspectRatios {
      16:9 {
        title = LLL:EXT:core/Resources/Private/Language/locallang_wizards.xlf:imwizard.ratio.16_9
        value = 1.7777777777778
      }
    }
  }

  3-2 {
    title = LLL:EXT:core/Resources/Private/Language/locallang_wizards.xlf:imwizard.ratio.3_2
    allowedAspectRatios {
      3:2 {
        title = LLL:EXT:core/Resources/Private/Language/locallang_wizards.xlf:imwizard.ratio.3_2
        value = 1.5
      }
    }
  }

  4-3 {
    title = LLL:EXT:core/Resources/Private/Language/locallang_wizards.xlf:imwizard.ratio.4_3
    allowedAspectRatios {
      4:3 {
        title = LLL:EXT:core/Resources/Private/Language/locallang_wizards.xlf:imwizard.ratio.4_3
        value = 1.3333333333333
      }
    }
  }

}


tx_news.templateLayouts {
  Default = LLL:EXT:newslayouts/Resources/Private/Language/tsconfig.xlf:templateLayouts.default
}

# Layout for news article
TCEFORM.tx_news_domain_model_news.layout.addItems {
  Default = LLL:EXT:newslayouts/Resources/Private/Language/tsconfig.xlf:templateLayouts.default
  #Default.icon = EXT:newslayouts/Resources/Public/Icons/layout1.svg
}

TCEFORM.tx_news_domain_model_news.fal_media.config.overrideChildTca.columns.crop.config.cropVariants {
  1-1 < cropVariants.1-1
  16-9 < cropVariants.16-9
}

TCEFORM.tx_news_domain_model_news.gallery.config.overrideChildTca.columns.crop.config.cropVariants {
  1-1 < cropVariants.1-1
}

tx_news.imageFormats {
  1-1 = LLL:EXT:core/Resources/Private/Language/locallang_wizards.xlf:imwizard.ratio.1_1
  16-9 = LLL:EXT:core/Resources/Private/Language/locallang_wizards.xlf:imwizard.ratio.16_9
}
