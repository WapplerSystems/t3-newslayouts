plugin.tx_news.settings {
    demandClass = WapplerSystems\Newslayouts\Domain\Model\Dto\Demand

}


plugin.tx_news.settings {

  imageClass = {$plugin.tx_news.settings.imageClass}

  latest {
    maxWidth = {$plugin.tx_news.settings.latest.maxWidth}
    maxHeight = {$plugin.tx_news.settings.latest.maxHeight}
    headingType = {$plugin.tx_news.settings.latest.headingType}
    showDate = {$plugin.tx_news.settings.latest.showDate}
    showCategory = {$plugin.tx_news.settings.latest.showCategory}
    showAuthor = {$plugin.tx_news.settings.latest.showAuthor}
  }

  list {
    maxWidth = {$plugin.tx_news.settings.list.maxWidth}
    maxHeight = {$plugin.tx_news.settings.list.maxHeight}
    headingType = {$plugin.tx_news.settings.list.headingType}
  }

  detail {
    top {
      maxWidth = {$plugin.tx_news.settings.detail.top.maxWidth}
      maxHeight = {$plugin.tx_news.settings.detail.top.maxHeight}
    }

    gallery {
      maxWidth = {$plugin.tx_news.settings.detail.gallery.maxWidth}
      maxHeight = {$plugin.tx_news.settings.detail.gallery.maxHeight}
    }

    maxWidth = {$plugin.tx_news.settings.detail.maxWidth}
    maxHeight = {$plugin.tx_news.settings.detail.maxHeight}
    headingType = {$plugin.tx_news.settings.detail.headingType}
  }


}
