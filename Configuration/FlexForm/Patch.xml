
<sheets>
    <template>
        <ROOT>
            <el>
                <settings.allowLayoutOverwriteByRecord>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:allowLayoutOverwriteByRecord</label>
                    <config>
                        <type>check</type>
                        <renderType>checkboxToggle</renderType>
                        <default>0</default>
                        <items>
                            <numIndex index="0" type="array">
                                <label></label>
                                <value>1</value>
                            </numIndex>
                        </items>
                    </config>
                </settings.allowLayoutOverwriteByRecord>
                <settings.imageFormat>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:imageFormat</label>
                    <description>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:imageFormat.description</description>
                    <config>
                        <type>select</type>
                        <renderType>selectSingle</renderType>
                        <itemsProcFunc>WapplerSystems\Newslayouts\Hooks\ItemsProcFunc->imageFormats</itemsProcFunc>
                        <default>default</default>
                        <items>
                            <numIndex index="0" type="array">
                                <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:imageFormat.default</label>
                                <value>default</value>
                            </numIndex>
                            <numIndex index="1" type="array">
                                <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:imageFormat.none</label>
                                <value></value>
                            </numIndex>
                        </items>
                    </config>
                </settings.imageFormat>
                <settings.meta.showDate>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:meta.showDate</label>
                    <config>
                        <type>check</type>
                        <renderType>checkboxToggle</renderType>
                        <default>1</default>
                        <items>
                            <numIndex index="0" type="array">
                                <label></label>
                                <value>1</value>
                            </numIndex>
                        </items>
                    </config>
                </settings.meta.showDate>
                <settings.meta.showCategory>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:meta.showCategory</label>
                    <config>
                        <type>select</type>
                        <renderType>selectSingle</renderType>
                        <default>first</default>
                        <items>
                            <numIndex index="0" type="array">
                                <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:meta.showCategory.none</label>
                                <value>none</value>
                            </numIndex>
                            <numIndex index="1" type="array">
                                <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:meta.showCategory.first</label>
                                <value>first</value>
                            </numIndex>
                            <numIndex index="2" type="array">
                                <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:meta.showCategory.all</label>
                                <value>all</value>
                            </numIndex>
                        </items>
                    </config>
                </settings.meta.showCategory>
                <settings.meta.showTags>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:meta.showTags</label>
                    <config>
                        <type>check</type>
                        <renderType>checkboxToggle</renderType>
                        <default>1</default>
                        <items>
                            <numIndex index="0" type="array">
                                <label></label>
                                <value>1</value>
                            </numIndex>
                        </items>
                    </config>
                </settings.meta.showTags>
                <settings.meta.showAuthor>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:meta.showAuthor</label>
                    <config>
                        <type>check</type>
                        <renderType>checkboxToggle</renderType>
                        <default>1</default>
                        <items>
                            <numIndex index="0" type="array">
                                <label></label>
                                <value>1</value>
                            </numIndex>
                        </items>
                    </config>
                </settings.meta.showAuthor>
            </el>
        </ROOT>
    </template>
    <slider>
        <ROOT>
            <sheetTitle>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.sheetTitle</sheetTitle>
            <sheetDescription>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.sheetDescription</sheetDescription>
            <type>array</type>
            <el>
                <settings.slider.breakpoints576>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.breakpoints576</label>
                    <description>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.breakpoints.description</description>
                    <displayCond>FIELD:template.settings.templateLayout:=:Slider</displayCond>
                    <config>
                        <type>number</type>
                        <size>4</size>
                        <default>1</default>
                    </config>
                </settings.slider.breakpoints576>
                <settings.slider.breakpoints768>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.breakpoints768</label>
                    <description>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.breakpoints.description</description>
                    <displayCond>FIELD:template.settings.templateLayout:=:Slider</displayCond>
                    <config>
                        <type>number</type>
                        <size>4</size>
                        <default>2</default>
                    </config>
                </settings.slider.breakpoints768>
                <settings.slider.breakpoints992>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.breakpoints992</label>
                    <description>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.breakpoints.description</description>
                    <displayCond>FIELD:template.settings.templateLayout:=:Slider</displayCond>
                    <config>
                        <type>number</type>
                        <size>4</size>
                        <default>3</default>
                    </config>
                </settings.slider.breakpoints992>
                <settings.slider.slidesPerGroup>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.slidesPerGroup</label>
                    <description>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.slidesPerGroup.description</description>
                    <displayCond>FIELD:template.settings.templateLayout:=:Slider</displayCond>
                    <config>
                        <type>number</type>
                        <size>4</size>
                        <default>0</default>
                    </config>
                </settings.slider.slidesPerGroup>
                <settings.slider.spaceBetween>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.spaceBetween</label>
                    <description>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.spaceBetween.description</description>
                    <displayCond>FIELD:template.settings.templateLayout:=:Slider</displayCond>
                    <config>
                        <type>number</type>
                        <size>4</size>
                        <default>20</default>
                    </config>
                </settings.slider.spaceBetween>
                <settings.slider.loop>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.loop</label>
                    <description>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.loop.description</description>
                    <displayCond>FIELD:template.settings.templateLayout:=:Slider</displayCond>
                    <config>
                        <type>check</type>
                        <renderType>checkboxToggle</renderType>
                        <default>0</default>
                        <items>
                            <numIndex index="0" type="array">
                                <label></label>
                                <value>1</value>
                            </numIndex>
                        </items>
                    </config>
                </settings.slider.loop>
                <settings.slider.navigation>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.navigation</label>
                    <description>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.navigation.description</description>
                    <displayCond>FIELD:template.settings.templateLayout:=:Slider</displayCond>
                    <config>
                        <type>check</type>
                        <renderType>checkboxToggle</renderType>
                        <default>1</default>
                        <items>
                            <numIndex index="0" type="array">
                                <label></label>
                                <value>1</value>
                            </numIndex>
                        </items>
                    </config>
                </settings.slider.navigation>
                <settings.slider.pagination>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.pagination</label>
                    <description>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.pagination.description</description>
                    <displayCond>FIELD:template.settings.templateLayout:=:Slider</displayCond>
                    <config>
                        <type>check</type>
                        <renderType>checkboxToggle</renderType>
                        <default>1</default>
                        <items>
                            <numIndex index="0" type="array">
                                <label></label>
                                <value>1</value>
                            </numIndex>
                        </items>
                    </config>
                </settings.slider.pagination>
                <settings.slider.autoplay>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.autoplay</label>
                    <description>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.autoplay.description</description>
                    <displayCond>FIELD:template.settings.templateLayout:=:Slider</displayCond>
                    <onChange>reload</onChange>
                    <config>
                        <type>check</type>
                        <renderType>checkboxToggle</renderType>
                        <default>0</default>
                        <items>
                            <numIndex index="0" type="array">
                                <label></label>
                                <value>1</value>
                            </numIndex>
                        </items>
                    </config>
                </settings.slider.autoplay>
                <settings.slider.delay>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.delay</label>
                    <description>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.delay.description</description>
                    <displayCond>
                        <AND>
                            <numIndex index="0">FIELD:template.settings.templateLayout:=:Slider</numIndex>
                            <numIndex index="1">FIELD:slider.settings.slider.autoplay:=:1</numIndex>
                        </AND>
                    </displayCond>
                    <config>
                        <type>number</type>
                        <size>6</size>
                        <default>5000</default>
                    </config>
                </settings.slider.delay>
                <settings.slider.newsTitleType>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.newsTitleType</label>
                    <displayCond>FIELD:template.settings.templateLayout:=:Slider</displayCond>
                    <config>
                        <type>select</type>
                        <renderType>selectSingle</renderType>
                        <default>4</default>
                        <items>
                            <numIndex index="0" type="array">
                                <label>H2</label>
                                <value>2</value>
                            </numIndex>
                            <numIndex index="1" type="array">
                                <label>H3</label>
                                <value>3</value>
                            </numIndex>
                            <numIndex index="2" type="array">
                                <label>H4</label>
                                <value>4</value>
                            </numIndex>
                            <numIndex index="3" type="array">
                                <label>H5</label>
                                <value>5</value>
                            </numIndex>
                        </items>
                    </config>
                </settings.slider.newsTitleType>
                <settings.slider.display>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.display</label>
                    <displayCond>FIELD:template.settings.templateLayout:=:Slider</displayCond>
                    <config>
                        <type>select</type>
                        <renderType>selectSingle</renderType>
                        <default>3</default>
                        <items>
                            <numIndex index="0" type="array">
                                <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.display.teaser</label>
                                <value>1</value>
                            </numIndex>
                            <numIndex index="1" type="array">
                                <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.display.bodytext</label>
                                <value>2</value>
                            </numIndex>
                            <numIndex index="2" type="array">
                                <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.display.both</label>
                                <value>3</value>
                            </numIndex>
                        </items>
                    </config>
                </settings.slider.display>
                <settings.slider.color>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.color</label>
                    <displayCond>FIELD:template.settings.templateLayout:=:Slider</displayCond>
                    <config>
                        <type>color</type>
                        <size>10</size>
                    </config>
                </settings.slider.color>
                <settings.slider.backgroundColor>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.backgroundColor</label>
                    <displayCond>FIELD:template.settings.templateLayout:=:Slider</displayCond>
                    <config>
                        <type>color</type>
                        <size>10</size>
                    </config>
                </settings.slider.backgroundColor>
                <settings.slider.disableCss>
                    <label>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.disableCss</label>
                    <description>LLL:EXT:newslayouts/Resources/Private/Language/locallang_db.xlf:slider.disableCss.description</description>
                    <displayCond>FIELD:template.settings.templateLayout:=:Slider</displayCond>
                    <config>
                        <type>check</type>
                        <renderType>checkboxToggle</renderType>
                        <default>0</default>
                        <items>
                            <numIndex index="0" type="array">
                                <label></label>
                                <value>1</value>
                            </numIndex>
                        </items>
                    </config>
                </settings.slider.disableCss>
            </el>
        </ROOT>
    </slider>
</sheets>

